<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Merchandise</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="stylesheet" href="/style.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Michroma&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <%- include('partials/nav') %>
    <h1>Merchandise</h1>
    <br />
    <br />
    <main class="product-grid">
      <div class="product">
        <img src="/images/tour-hoodie.jpg" alt="tour Hoodie" />
        <div class="product-info">
          <h2>Tour Hoodie</h2>
          <p class="price">$57</p>
        </div>
        <form action="/cart/add" method="POST">
          <input type="hidden" name="id" value="hoodie" />
          <input type="hidden" name="name" value="Tour Hoodie" />
          <input type="hidden" name="price" value="57" />
          <input type="hidden" name="type" value="merch" />
          <input type="hidden" name="image" value="tour-hoodie.jpg" />
          <button type="submit">Add to Cart</button>
        </form>
      </div>

      <div class="product">
        <img src="/images/official-tshirt.jpg" alt="official T-Shirt" />
        <div class="product-info">
          <h2>Official T-Shirt</h2>
          <p class="price">$47</p>
        </div>
        <form action="/cart/add" method="POST">
          <input type="hidden" name="id" value="tshirt" />
          <input type="hidden" name="name" value="Official T-Shirt" />
          <input type="hidden" name="price" value="47" />
          <input type="hidden" name="type" value="merch" />
          <input type="hidden" name="image" value="official-tshirt.jpg" />
          <button type="submit">Add to Cart</button>
        </form>
      </div>

      <div class="product">
        <img src="/images/poster.jpg" alt="poster" />
        <div class="product-info">
          <h2>Poster</h2>
          <p class="price">$15</p>
        </div>
        <form action="/cart/add" method="POST">
          <input type="hidden" name="id" value="poster" />
          <input type="hidden" name="name" value="Poster" />
          <input type="hidden" name="price" value="15" />
          <input type="hidden" name="type" value="merch" />
          <input type="hidden" name="image" value="poster.jpg" />
          <button type="submit">Add to Cart</button>
        </form>
      </div>
    </main>
  </body>
</html>
