<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>Checkout</title>
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <link rel="stylesheet" href="style.css" />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link
            href="https://fonts.googleapis.com/css2?family=Michroma&display=swap"
            rel="stylesheet">

    </head>
    <body>
        <%- include('partials/nav') %>

        <div class="checkout-box">
            <form class="checkout-form" action="/checkout" method="POST">
                <p class="checkout-title">Checkout</p>

                <% if (typeof error!=='undefined'&& error) { %>
                <p class="error-message"><%= error %></p>
                <% } %>

                <div class="checkoutGroup">
                    <label>First name</label>
                    <input type="text" name="firstName" placeholder="Enter your first name">
                </div>

                <div class="checkoutGroup">
                    <label>Last name</label>
                    <input type="text" name="lastName" placeholder="Enter your last name">
                </div>

                <div class="checkoutGroup">
                    <label>Address</label>
                    <input type="text" name="address" placeholder="Enter your address">
                </div>

                <div class="checkoutGroup">
                    <label>Email</label>
                    <input type="email" name="email" placeholder="Enter your email">
                </div>

                <div class="checkoutGroup">
                    <label>Card Number</label>
                    <input type="text" name="cardNumber" placeholder="Enter your Card Number">
                </div>
                 <div class="checkoutGroup">
                    <label>CVV</label>
                    <input type="text" name="cvv" placeholder="The 3 digits on the back of your card">
                </div>
                 <div class="checkoutGroup">
                    <label>Expiry Date</label>
                    <input type="date" name="expiryDate" placeholder="Enter your Expiry Date">
                </div>

                <a href="/orderplaced" id="orderPlaced-btn">Checkout</a>
            </form>
        </div>
    </body>
</html>
